# Existing .env is never overwritten. USERNAME/PASSWORD are school credentials.
USERNAME=
PASSWORD=
BOOK_ID=
SCHOOL_NAME=ZAAM
SCHOOL_GROUP=SECONDARY
HEADLESS=false
HOST=127.0.0.1
PORT=3000
VIEW_PORT=3001
# Optional: the local UI generates a temporary password if these are absent.
APP_USERNAME=local
APP_PASSWORD=
OUTPUT_DIR=./output
DATA_DIR=./data
MAX_PAGES=500
MAX_JOB_MINUTES=120
REQUEST_DELAY_MS=1000
MAX_ASSET_MB=25
MAX_JOB_MB=1000
LANGUAGE_PROVIDER=disabled
LANGUAGE_API_KEY=
LANGUAGE_MODEL=
# Optional, exact HTTPS origin of your school's credential form.
# Credentials are never automatically entered on an unlisted origin.
SCHOOL_LOGIN_ORIGIN=
